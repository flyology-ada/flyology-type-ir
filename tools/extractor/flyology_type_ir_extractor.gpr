with "config/flyology_type_ir_extractor_config.gpr";
project Flyology_Type_IR_Extractor is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use
     ("flyology_type_ir_extract.adb", "flyology_type_ir_lal_probe.adb");
end Flyology_Type_IR_Extractor;
